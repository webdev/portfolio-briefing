# E*TRADE app consumer credentials.
# Get these from https://us.etrade.com/etx/ris/apikey after enrolling in
# E*TRADE's Developer Platform. They are NOT the same as your login credentials.
#
# Copy this file to `.env` (which is gitignored) and fill in real values.
# The briefing pipeline reads these via scripts/etrade_auth.py.
ETRADE_CONSUMER_KEY=your_etrade_consumer_key_here
ETRADE_CONSUMER_SECRET=your_etrade_consumer_secret_here

# (Optional) Financial Modeling Prep API key — enables the intrinsic-value read
# (DCF + analyst price targets) on every single-stock recommendation. Without
# it the briefing still runs and shows a "not configured" footer (fail-closed,
# no fabricated values). Get a free key at https://site.financialmodelingprep.com/
# (free tier ~250 calls/day; the briefing uses ~2 calls per recommended stock,
# cached 24h). The DCF endpoint is on the free tier; analyst price targets may
# require a paid plan — the code degrades gracefully and shows whatever is available.
FMP_API_KEY=your_fmp_api_key_here

# --- Schwab instance only (leave unset for the E*TRADE setup) ---
# Set the backend to Schwab and provide the developer-app credentials from
# https://developer.schwab.com. OAuth2 access tokens last 30 min (refreshed
# silently); the refresh token forces a fresh browser auth ~weekly. Read-only.
# PORTFOLIO_BRIEFING_BROKER=schwab
# SCHWAB_APP_KEY=your_app_key
# SCHWAB_APP_SECRET=your_app_secret
# SCHWAB_REDIRECT_URI=https://127.0.0.1
# SCHWAB_TOKEN_FILE=~/.config/portfolio-briefing/schwab_tokens.json
