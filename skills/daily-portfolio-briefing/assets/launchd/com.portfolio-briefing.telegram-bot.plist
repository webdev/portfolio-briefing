<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.portfolio-briefing.telegram-bot</string>

  <key>ProgramArguments</key>
  <array>
    <string>/Users/gblazer/.local/bin/uv</string>
    <string>run</string>
    <string>--project</string>
    <string>/Users/gblazer/workspace/portfolio-briefing</string>
    <string>python</string>
    <string>/Users/gblazer/workspace/portfolio-briefing/skills/daily-portfolio-briefing/scripts/telegram_briefing_bot.py</string>
  </array>

  <key>WorkingDirectory</key>
  <string>/Users/gblazer/workspace/portfolio-briefing</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PORTFOLIO_BRIEFING_REPO</key>
    <string>/Users/gblazer/workspace/portfolio-briefing</string>
    <key>PORTFOLIO_BRIEFING_PYTHON</key>
    <string>/Users/gblazer/workspace/portfolio-briefing/.venv/bin/python</string>
    <key>PATH</key>
    <string>/Users/gblazer/.local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/gblazer/Documents/briefings/logs/telegram_bot.out.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/gblazer/Documents/briefings/logs/telegram_bot.err.log</string>
</dict>
</plist>
